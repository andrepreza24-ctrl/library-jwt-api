{
    "openapi": "3.0.0",
    "info": {
        "title": "API E-Commerce Segura",
        "description": "Documentación interactiva de endpoints con JWT y Stripe",
        "version": "1.0.0"
    },
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Registro de usuario",
                "operationId": "9b3c552d1e20a18e6b235dabda25ad5c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Cliente Ejemplo"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "cliente@email.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario registrado con éxito"
                    }
                },
                "servers": [
                    {
                        "url": "http://localhost:8000",
                        "description": "Servidor Local Docker"
                    }
                ]
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión",
                "operationId": "40d69d6466750a16c6b4548092333bd4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "cliente@email.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token JWT generado"
                    }
                },
                "servers": [
                    {
                        "url": "http://localhost:8000",
                        "description": "Servidor Local Docker"
                    }
                ]
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Obtener catálogo de productos",
                "operationId": "6512d47619ec7d9b8ae6d16e85ae42f5",
                "responses": {
                    "200": {
                        "description": "Lista de productos obtenida"
                    }
                },
                "servers": [
                    {
                        "url": "http://localhost:8000",
                        "description": "Servidor Local Docker"
                    }
                ]
            }
        },
        "/api/orders": {
            "post": {
                "tags": [
                    "Órdenes"
                ],
                "summary": "Crear orden y procesar pago con Stripe",
                "operationId": "36b662c190ef357e31f3e6d79604fe33",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "items",
                                    "stripe_token"
                                ],
                                "properties": {
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "product_id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "quantity": {
                                                    "type": "integer",
                                                    "example": 2
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "stripe_token": {
                                        "type": "string",
                                        "example": "tok_visa"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Orden creada y pago procesado en Stripe"
                    },
                    "401": {
                        "description": "No autorizado (JWT requerido)"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "servers": [
                    {
                        "url": "http://localhost:8000",
                        "description": "Servidor Local Docker"
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Autenticación",
            "description": "Autenticación"
        },
        {
            "name": "Productos",
            "description": "Productos"
        },
        {
            "name": "Órdenes",
            "description": "Órdenes"
        }
    ]
}